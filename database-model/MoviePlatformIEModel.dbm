<table name="WatchList" layers="0" collapse-mode="1" max-obj-count="3" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="640" y="20"/>

	<customidxs object-type="column">
		<object name="idM" index="1"/>
		<object name="idU" index="0"/>
	</customidxs>
	<customidxs object-type="constraint">
		<object name="Movie_fk" index="1"/>
		<object name="User_fk" index="2"/>
		<object name="WatchList_pk" index="0"/>
	</customidxs></table>

<relationship name="wants to be watched by" type="rel1n" layers="0"
	 src-col-pattern="idM"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 fk-idx-pattern="{st}_idx"
	 custom-color="#6a178c"
	 src-table="public.&quot;Movie&quot;"
	 dst-table="public.&quot;WatchList&quot;"
	 src-required="true" dst-required="false"
	 identifier="true"

	upd-action="CASCADE"
	del-action="NO ACTION">
	<label ref-type="name-label">
		<position x="-7.05691" y="-5.52741"/>
	</label>
</relationship>

<relationship name="wants to watch" type="rel1n" layers="0"
	 src-col-pattern="idU"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="{st}_fk"
	 fk-idx-pattern="{st}_idx"
	 custom-color="#b66f6c"
	 src-table="public.&quot;User&quot;"
	 dst-table="public.&quot;WatchList&quot;"
	 src-required="true" dst-required="false"
	 identifier="true"

	upd-action="CASCADE"
	del-action="NO ACTION">
	<label ref-type="name-label">
		<position x="10.2953" y="-10.639"/>
	</label>
</relationship>

<table name="MovieRating" layers="0" collapse-mode="1" max-obj-count="4" z-value="0">
	<schema name="public"/>
	<role name="postgres"/>
	<position x="640" y="220"/>
	<column name="rating" not-null="true">
		<type name="integer" length="0"/>
	</column>
	<column name="date" not-null="true" default-value="GETDATE()">
		<type name="timestamp" length="0"/>
	</column>
	<constraint name="CK_rating" type="ck-constr" table="public.&quot;MovieRating&quot;">
			<expression> <![CDATA[rating BETWEEN 1 AND 10]]> </expression>
	</constraint>

	<customidxs object-type="column">
		<object name="idM" index="1"/>
		<object name="idU" index="0"/>
	</customidxs>
	<customidxs object-type="constraint">
		<object name="MovieRating_pk" index="0"/>
		<object name="Movie_fk" index="1"/>
		<object name="User_fk" index="2"/>
	</customidxs></table>

